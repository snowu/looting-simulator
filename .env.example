# Copy to .env (gitignored) for local development. Both values are public by
# design: they ship inside the browser bundle, and authorization comes from the
# player's JWT plus row-level security, not from keeping these hidden.
#
# Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put the service-role key here, in the repo, or in any Vite variable.
# It bypasses row-level security entirely and must stay server-side only.
